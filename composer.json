{
    "name": "transactionmonitor/monitor",
    "require": {
        "php": "^8.1",
        "slim/slim": "^4.10",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "php-di/slim-bridge": "^3.3",
        "nyholm/psr7": "^1.5",
        "nyholm/psr7-server": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "TransactionMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TransactionMonitor\\Tests\\": "tests/"
        }
    }
}